NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/fyro?retryWrites=true&w=majority
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=ChangeMe123!
MOCK_EXTERNAL_SERVICES=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Per-integration mock switches (each falls back to MOCK_EXTERNAL_SERVICES) ---
MOCK_PAYMENTS=
MOCK_UPLOADS=
MOCK_OTP=

# --- Razorpay (TEST mode keys for the demo; required when MOCK_PAYMENTS=false in production) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- P0.2 customer-confirmed completion ---
# Hours a finished job waits for the customer before it is confirmed automatically.
AUTO_CONFIRM_HOURS=24

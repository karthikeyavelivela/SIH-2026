NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/fyro?retryWrites=true&w=majority
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=ChangeMe123!
MOCK_EXTERNAL_SERVICES=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Per-integration mock switches (each falls back to MOCK_EXTERNAL_SERVICES) ---
MOCK_PAYMENTS=
MOCK_UPLOADS=
MOCK_OTP=

# --- Razorpay (TEST mode keys for the demo; required when MOCK_PAYMENTS=false in production) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- P0.2 customer-confirmed completion ---
# Hours a finished job waits for the customer before it is confirmed automatically.
AUTO_CONFIRM_HOURS=24
# P0.4: key per-IP rate limits on Cloudflare's CF-Connecting-IP. Only true on a
# deployment that is actually behind Cloudflare (Render is).
TRUST_CLOUDFLARE=false

# P1.2 - demand-indexed welfare pool. Policy parameters (defaults shown), to be
# confirmed by the federations. The individual earnings trigger stays off.
WELFARE_TRIGGER_INDEX=0.6
WELFARE_PAYOUT_CAP_PCT=40
WELFARE_PER_MEMBER_CAP=1000
WELFARE_MIN_SOCIETY_MEMBERS=5
WELFARE_MIN_ACTIVE_DAYS=8
WELFARE_MIN_HISTORY_WEEKS=4
INDIVIDUAL_EARNINGS_TRIGGER=false

# P1.4 - urgent booking search rings (km) and offer countdown (ms)
URGENT_RADII_KM=3,6,10
URGENT_OFFER_TIMEOUT_MS=12000

# P1.5 - hours a dispute waits at one level before escalating by itself
DISPUTE_SLA_HOURS=48
